// ============================================================================
// VDONinjaPlayer - Resource File
// Defines application icons and resources
// ============================================================================

#include <windows.h>

// Application icon - used for window and tray
// ID 101 corresponds to IDI_APPICON defined in App.h
101 ICON "icon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "VDONinjaPlayer"
			VALUE "FileDescription", "VDONinja Player - High Priority Streaming Application"
			VALUE "FileVersion", "0.1.0.0"
			VALUE "InternalName", "VDONinjaPlayer.exe"
			VALUE "LegalCopyright", "2024"
			VALUE "OriginalFilename", "VDONinjaPlayer.exe"
			VALUE "ProductName", "VDONinja Player"
			VALUE "ProductVersion", "0.1.0.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
